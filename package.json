{
  "name": "luxebaddie",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "dev": "pnpm --filter @luxebaddie/web dev",
    "build": "pnpm --filter @luxebaddie/web build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter @luxebaddie/web lint",
    "deploy:dev": "pnpm --filter @luxebaddie/backend deploy:dev",
    "seed:dev": "pnpm --filter @luxebaddie/backend seed:dev",
    "test:e2e": "pnpm --filter @luxebaddie/backend test:e2e",
    "prepare": "if [ -e .git ]; then git config core.hooksPath .githooks; fi"
  }
}
