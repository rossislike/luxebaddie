#!/usr/bin/env bash
# Refuses commits that contain a Stripe API key or webhook signing secret.
# Keys belong in AWS SSM Parameter Store (see backend/scripts/stripe-setup.ts),
# never in the repository: leaked keys in git are the leading cause of
# Stripe account takeovers.
set -euo pipefail

# sk_/rk_ = secret and restricted API keys, whsec_ = webhook signing secrets.
# The length requirement lets placeholders such as "sk_test_..." through.
secret_pattern='((sk|rk)_(live|test)_[0-9A-Za-z]{16,}|whsec_[0-9A-Za-z]{16,})'

leaks=$(git diff --cached --unified=0 --no-color | grep -E '^\+' | grep -E -o "$secret_pattern" || true)

if [ -n "$leaks" ]; then
  echo "Commit blocked: staged changes contain what looks like a Stripe secret:" >&2
  echo "$leaks" | sed -E 's/(.{12}).*/  \1.../' >&2
  echo "Remove it, and if it was ever committed or shared, roll the key in the Stripe Dashboard." >&2
  exit 1
fi
