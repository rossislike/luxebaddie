# Base URL of the backend API for the stage this storefront talks to.
# It is the ApiUrl output of the LuxeBaddie-<stage> stack (pnpm deploy:dev prints it).
NEXT_PUBLIC_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev

# Public address of the storefront, used to build absolute links for social share previews.
# Leave unset until the site has a domain.
# NEXT_PUBLIC_SITE_URL=https://luxebaddie.com
