{
  "name": "@luxebaddie/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cdk": "cdk",
    "synth": "cdk synth -c stage=dev --quiet",
    "diff:dev": "cdk diff -c stage=dev",
    "deploy:dev": "cdk deploy -c stage=dev --require-approval never --outputs-file cdk-outputs.dev.json",
    "seed:dev": "tsx scripts/seed.ts dev",
    "stripe:setup:dev": "tsx scripts/stripe-setup.ts dev",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "typecheck": "tsc --noEmit",
    "db": "tsx scripts/db.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1169.0",
    "@aws-sdk/client-eventbridge": "^3.1169.0",
    "@aws-sdk/client-ssm": "^3.1169.0",
    "@aws-sdk/lib-dynamodb": "^3.1169.0",
    "@luxebaddie/contracts": "workspace:*",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1169.0",
    "@aws-sdk/credential-providers": "^3.1169.0",
    "@types/aws-lambda": "^8.10.150",
    "@types/node": "^22",
    "aws-cdk": "^2.1148.1",
    "aws-cdk-lib": "^2.277.0",
    "aws4fetch": "^1.0.20",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
