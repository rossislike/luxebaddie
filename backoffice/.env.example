# Settings for running the back office on your own machine (pnpm dev:backoffice,
# http://localhost:3001). Copy this file to .env.local and fill each value in
# from the outputs of the LuxeBaddie-<stage> stack (pnpm deploy:dev prints them,
# and backend/cdk-outputs.dev.json keeps them). The hosted back office needs
# none of this: its build is given the same values (backend/lib/luxebaddie-stack.ts).

# ApiUrl output.
NEXT_PUBLIC_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev

# OwnerSignInIssuer output: the Cognito user pool, as the address tokens are issued by.
NEXT_PUBLIC_SIGN_IN_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_xxxxxxxxx

# OwnerUserPoolClientId output.
NEXT_PUBLIC_SIGN_IN_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# OwnerSignInPagesUrl output: where Cognito hosts the sign-in pages.
NEXT_PUBLIC_SIGN_IN_PAGES_URL=https://luxebaddie-dev-xxxxxxxx.auth.us-east-1.amazoncognito.com
